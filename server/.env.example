# Local development environment for NestJS server
# Postgres from docker-compose is exposed on localhost:5432
DATABASE_URL=

# App runtime config
PORT=8080
CORS_ALLOWED_ORIGINS=

# Dev auth - DISABLED by default
# Override in .env.local to enable DevAuth for testing
DEV_AUTH_ENABLED=
DEV_AUTH_TOKEN=

# Admin Emails (comma-separated, for future admin whitelist feature)
ADMIN_EMAILS=


GEMINI_API_KEY=
USE_MOCK_IMAGE=

APPLE_SHARED_SECRET=